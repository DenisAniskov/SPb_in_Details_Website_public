---
import Icon from './Icon.astro';
import { release, project } from '../lib/site';
import { docUrl } from '../lib/release';

// The first six features are the ones a first-time visitor needs to understand
// the app; the rest stay on the page but collapse behind one summary so the
// section reads as a story about walks, not a spec sheet. The full list itself
// lives in project.json and is validated as before.
const primary = project.features.slice(0, 6);
const more = project.features.slice(6);
---

<section class="section" id="features">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Возможности</p>
      <h2 class="balance">Что можно делать с приложением</h2>
      <p class="lead">
        Всё перечисленное есть в опубликованной версии. Ничего сверх этого списка сайт не обещает.
      </p>
    </div>

    <div class="grid grid--features">
      {
        primary.map((feature) => (
          <article class="card card--hover">
            <span class="card__icon">
              <Icon name={feature.icon} size={22} />
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.summary}</p>
          </article>
        ))
      }
    </div>

    {
      more.length > 0 && (
        <details class="disclosure features__more">
          <summary>Ещё возможности</summary>
          <div class="grid grid--features">
            {more.map((feature) => (
              <article class="card">
                <span class="card__icon">
                  <Icon name={feature.icon} size={22} />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.summary}</p>
              </article>
            ))}
          </div>
        </details>
      )
    }

    <div class="notice features__footnote">
      <Icon name="alert" size={20} />
      <p>
        <strong>Честно об ограничениях.</strong> Нужен интернет: офлайн-карт нет. Оценки тени,
        тишины и пыльцы — расчётные модели, а не измерения. Ответы ИИ-помощника могут содержать
        ошибки. {project.safetyNotice} Полный список ограничений — <a
          href={docUrl(release, 'knownLimitations')}
          rel="noopener noreferrer">в документации приложения</a
        >.
      </p>
    </div>
  </div>
</section>
